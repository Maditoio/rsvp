# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (pooled connection string recommended on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk — identity only. App DB owns organisations and event roles.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx
PLATFORM_ADMIN_EMAILS=owner@example.com,ops@example.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Resend — use a verified domain; avoid noreply@ (hurts deliverability)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="Bizcon RSVP <invites@example.com>"
RESEND_REPLY_TO_EMAIL=support@example.com
RESEND_SUPPORT_EMAIL=support@example.com

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Blob (contact imports)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (public invite / register)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (optional)
SENTRY_DSN=

# Google Calendar OAuth
# Register this exact redirect URI in Google Cloud Console:
# https://bizconrsvp.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Calendar + Teams online meetings OAuth (Entra ID / Azure AD)
# Register this exact redirect URI in Microsoft Entra:
# https://bizconrsvp.com/api/auth/microsoft/callback
# API permissions (delegated): Calendars.ReadWrite, OnlineMeetings.ReadWrite, offline_access, openid
# Existing connected users must reconnect once after OnlineMeetings.ReadWrite is added.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: set to a specific tenant ID to restrict sign-in. Default: "common" (any account).
# MICROSOFT_TENANT_ID=common

# HubSpot OAuth (organisation-owned CRM connection)
# Register this exact redirect URI in HubSpot app settings:
# https://bizconrsvp.com/api/auth/hubspot/callback
# Dev: {NEXT_PUBLIC_APP_URL}/api/auth/hubspot/callback
# Scopes: oauth, crm.objects.contacts.read
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Salesforce OAuth Web Server flow (organisation-owned CRM connection)
# Register this exact callback URL on the Connected App:
# https://bizconrsvp.com/api/auth/salesforce/callback
# Dev: either register {NEXT_PUBLIC_APP_URL}/api/auth/salesforce/callback too,
#      or set SALESFORCE_REDIRECT_URI to the Connected App callback (exact match).
# A redirect_uri mismatch OR missing PKCE (code_challenge) returns a body Salesforce
# serves without Content-Type — browsers then download a file named "authorize".
# Connected App: enable "Require Proof Key for Code Exchange (PKCE)" is OK — we send PKCE.
# Scopes: api, refresh_token, offline_access (Contact read via REST/SOQL; enable refresh tokens)
# Authorize: {SALESFORCE_LOGIN_URL}/services/oauth2/authorize
# Token:     {SALESFORCE_LOGIN_URL}/services/oauth2/token
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Optional override — must match a Connected App callback exactly.
# SALESFORCE_REDIRECT_URI=https://bizconrsvp.com/api/auth/salesforce/callback
# Optional login host. Default: https://login.salesforce.com (sandbox: https://test.salesforce.com).
# Always include https:// — a bare host becomes a relative redirect Location.
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Callback URL to register on the Connected App (exact match, no trailing slash):
#   https://bizconrsvp.com/api/auth/salesforce/callback
# Selected OAuth scopes on the Connected App must include: api, refresh_token, offline_access


# Optional dedicated key for AES-256-GCM secret encryption (attendance QR, HubSpot/Salesforce tokens).
# If unset, CLERK_SECRET_KEY is used as the key material (see src/lib/crypto/secret.ts).
# TOKEN_ENCRYPTION_KEY=

# OpenAI — Phase 3 only, unused in Phase 1
OPENAI_API_KEY=
# Set this to the exact OpenAI API model id you want to use for matchmaking insights.
# Example fallback: gpt-4o-mini
OPENAI_MATCH_MODEL=
