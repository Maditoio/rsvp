# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (pooled connection string recommended on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk — identity only. App DB owns organisations and event roles.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx
PLATFORM_ADMIN_EMAILS=owner@example.com,ops@example.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Resend
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="Bizcon RSVP <invites@example.com>"

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Vercel Blob (contact imports)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (public invite / register)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (optional)
SENTRY_DSN=

# OpenAI — Phase 3 only, unused in Phase 1
OPENAI_API_KEY=
