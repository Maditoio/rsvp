model EmailMessage {
  id             String             @id @default(cuid())
  organisationId String
  eventId        String?
  invitationId   String?
  campaignId     String?
  templateId     String?
  toEmail        String
  subject        String
  providerId     String?
  status         EmailMessageStatus @default(QUEUED)
  createdAt      DateTime           @default(now())
  sentAt         DateTime?

