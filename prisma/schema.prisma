generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
}

enum EventRole {
  EVENT_ADMINISTRATOR
  REGISTRATION_MANAGER
  CHECKIN_STAFF
}

enum InvitationStatus {
  DRAFT
  SCHEDULED
  SENT
  DELIVERED
  OPENED
  ACCEPTED
  DECLINED
  EXPIRED
  BOUNCED
  CANCELLED
}

enum InvitationActivityType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
}

enum RegistrationStatus {
  NOT_STARTED
  INCOMPLETE
  COMPLETED
  CONFIRMED
  CANCELLED
  WAITLISTED
}

enum AttendeeStatus {
  REGISTERED
  CONFIRMED
  CHECKED_IN
  NO_SHOW
  CANCELLED
}

enum MeetingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EmailMessageStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
}

enum DataRequestType {
  EXPORT
  DELETE
  RECTIFY
}

enum DataRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileKind {
  CONTACT_IMPORT
  EXPORT
  EVENT_ASSET
  OTHER
}

enum SessionFormat {
  PHYSICAL
  ONLINE
  HYBRID
}

enum OnlineMeetingProvider {
  TEAMS
  ZOOM
}

enum CommunicationAutomationTrigger {
  INVITATION_NOT_ACCEPTED
  INVITATION_NOT_REGISTERED
  MEETING_ACCEPTED
  EVENT_STARTS_BEFORE
}

enum CommunicationAutomationAction {
  SEND_INVITATION_REMINDER
  SEND_REGISTRATION_REMINDER
  SEND_MEETING_CONFIRMATION
  SEND_EVENT_REMINDER
}

enum EventSponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  STRATEGIC_PARTNER
}

model User {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique
  email         String
  firstName     String?
  lastName      String?
  imageUrl      String?
  platformAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organisationUsers OrganisationUser[]
  eventUsers        EventUser[]
  attendees         Attendee[]
  checkInsPerformed CheckIn[]           @relation("CheckedInBy")
  auditLogs         AuditLog[]
  notifications     Notification[]
  calendarConnections CalendarConnection[]
  hubSpotConnections      HubSpotConnection[]      @relation("HubSpotConnectedBy")
  salesforceConnections   SalesforceConnection[]   @relation("SalesforceConnectedBy")
  dataRequests      DataRequest[]
  mapAnalyticsEvents MapAnalyticsEvent[]

  @@index([email])
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Platform-admin gate: AI floor-plan assist (detect/plot). Manual map flow always available.
  venueAiFloorPlanEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   OrganisationUser[]
  events                  Event[]
  contacts                Contact[]
  contactTags             ContactTag[]
  invitationCategories    InvitationCategory[]
  invitations             Invitation[]
  invitationActivities    InvitationActivity[]
  registrationForms       RegistrationForm[]
  registrationFields      RegistrationField[]
  registrationResponses   RegistrationResponse[]
  attendees               Attendee[]
  attendeeProfiles        AttendeeProfile[]
  attendeePrivacy         AttendeePrivacy[]
  sessions                Session[]
  sessionRegistrations    SessionRegistration[]
  matchmakingProfiles     MatchmakingProfile[]
  matchScores             MatchScore[]
  meetingRequests         MeetingRequest[]
  meetings                Meeting[]
  meetingParticipants     MeetingParticipant[]
  meetingRooms            MeetingRoom[]
  calendarConnections     CalendarConnection[]
  calendarEvents          CalendarEvent[]
  checkIns                CheckIn[]
  badges                  Badge[]
  badgeCredentials        BadgeCredential[]
  badgeAccessScans        BadgeAccessScan[]
  emailTemplates          EmailTemplate[]
  emailCampaigns          EmailCampaign[]
  emailMessages           EmailMessage[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  consents                Consent[]
  dataRequests            DataRequest[]
  apiKeys                 ApiKey[]
  webhooks                Webhook[]
  files                   FileObject[]
  eventSettings           EventSettings[]
  eventUsers              EventUser[]
  applications            EventApplication[]
  hubSpotConnection       HubSpotConnection?
  salesforceConnection    SalesforceConnection?
  oauthStates             OAuthState[]
  onlineMeetings          OnlineMeeting[]
  eventPolls              EventPoll[]
  eventPollQuestions      EventPollQuestion[]
  eventPollResponses      EventPollResponse[]
  eventPollAnswers        EventPollAnswer[]
  communicationAutomations CommunicationAutomation[]
  venueFloorPlans         VenueFloorPlan[]
  mapPois                 MapPoi[]
  mapCheckpoints          MapCheckpoint[]
  attendeeMapLocations    AttendeeMapLocation[]
  mapAnalyticsEvents      MapAnalyticsEvent[]
  eventSponsors           EventSponsor[]
  eventSpeakers           EventSpeaker[]
}

model OrganisationUser {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model Event {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  slug           String
  description    String?
  venue          String?
  timezone       String    @default("UTC")
  startsAt       DateTime?
  endsAt         DateTime?
  logoUrl        String?
  website        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation          Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  settings              EventSettings?
  users                 EventUser[]
  contacts              Contact[]
  invitationCategories  InvitationCategory[]
  invitations           Invitation[]
  invitationActivities  InvitationActivity[]
  registrationForms     RegistrationForm[]
  registrationFields    RegistrationField[]
  registrationResponses RegistrationResponse[]
  attendees             Attendee[]
  attendeeProfiles      AttendeeProfile[]
  attendeePrivacy       AttendeePrivacy[]
  sessions              Session[]
  sessionRegistrations  SessionRegistration[]
  matchmakingProfiles   MatchmakingProfile[]
  matchScores           MatchScore[]
  meetingRequests       MeetingRequest[]
  meetings              Meeting[]
  meetingParticipants   MeetingParticipant[]
  meetingRooms          MeetingRoom[]
  calendarEvents        CalendarEvent[]
  checkIns              CheckIn[]
  badges                Badge[]
  badgeCredentials      BadgeCredential[]
  badgeAccessScans      BadgeAccessScan[]
  emailTemplates        EmailTemplate[]
  emailCampaigns        EmailCampaign[]
  emailMessages         EmailMessage[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  consents              Consent[]
  files                 FileObject[]
  applications          EventApplication[]
  onlineMeetings        OnlineMeeting[]
  polls                 EventPoll[]
  pollQuestions         EventPollQuestion[]
  pollResponses         EventPollResponse[]
  pollAnswers           EventPollAnswer[]
  communicationAutomations CommunicationAutomation[]
  venueFloorPlans          VenueFloorPlan[]
  mapPois                  MapPoi[]
  mapCheckpoints           MapCheckpoint[]
  attendeeMapLocations     AttendeeMapLocation[]
  mapAnalyticsEvents       MapAnalyticsEvent[]
  sponsors                 EventSponsor[]
  speakers                 EventSpeaker[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model EventSponsor {
  id             String           @id @default(cuid())
  organisationId String
  eventId        String
  name           String
  websiteUrl     String?
  tier           EventSponsorTier @default(GOLD)
  logoUrl        String?
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organisationId, eventId])
  @@index([eventId, tier, sortOrder])
}

model EventSpeaker {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String
  firstName      String
  lastName       String   @default("")
  jobTitle       String?
  organization   String?
  country        String?
  bio            String?
  photoUrl       String?
  linkedInUrl    String?
  websiteUrl     String?
  featured       Boolean  @default(false)
  hidden         Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organisationId, eventId])
  @@index([eventId, sortOrder])
}

model EventSettings {
  id                     String  @id @default(cuid())
  organisationId         String
  eventId                String  @unique
  invitationExpiryDays   Int     @default(30)
  allowPublicApplication Boolean @default(false)
  capacity               Int?
  waitlistEnabled        Boolean @default(false)
  aiInsightsEnabled      Boolean @default(false)
  automationsEnabled     Boolean @default(true)
  meetingDurationMinutes Int     @default(15)
  eventStartTime         String  @default("09:00")
  eventEndTime           String  @default("18:00")
  /// Category rules, caps, batch triggers, reminder toggles (JSON).
  operationsConfig       Json?
  /// Badge template id, field toggles (JSON).
  badgeConfig            Json?
  /// Event marketing microsite content, theme, and section toggles (JSON).
  websiteConfig          Json?
  /// When set, the public event site at /e/{org}/{event} is live.
  websitePublishedAt     DateTime?
  /// Custom domain for this event's public site (e.g. tickets.acme.com), lowercased, no protocol/path.
  customDomain           String?   @unique
  /// none | pending | verified | error
  customDomainStatus     String    @default("none")
  customDomainError      String?
  customDomainRequestedAt DateTime?
  customDomainVerifiedAt DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model CommunicationAutomation {
  id             String                         @id @default(cuid())
  organisationId String
  eventId        String
  name           String?
  trigger        CommunicationAutomationTrigger
  delayDays      Int                            @default(5)
  action         CommunicationAutomationAction
  enabled        Boolean                        @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organisationId, eventId])
  @@index([eventId, enabled])
}

model EventApplication {
  id             String            @id @default(cuid())
  organisationId String
  eventId        String
  email          String
  firstName      String
  lastName       String
  company        String?
  jobTitle       String?
  country        String?
  message        String?
  status         ApplicationStatus @default(PENDING)
  invitationId   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([organisationId, eventId, status])
}

model EventUser {
  id             String    @id @default(cuid())
  organisationId String
  eventId        String
  userId         String
  role           EventRole
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([organisationId])
  @@index([userId])
}

model Contact {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String
  email          String
  firstName      String
  lastName       String
  phone          String?
  company        String?
  jobTitle       String?
  country        String?
  notes          String?
  vip            Boolean  @default(false)
  speaker        Boolean  @default(false)
  sponsor        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tags         ContactTagOnContact[]
  invitations  Invitation[]
  registrations RegistrationResponse[]
  attendees    Attendee[]

  @@unique([eventId, email])
  @@index([organisationId])
  @@index([eventId])
}

model ContactTag {
  id             String @id @default(cuid())
  organisationId String
  name           String

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contacts     ContactTagOnContact[]

  @@unique([organisationId, name])
}

model ContactTagOnContact {
  contactId String
  tagId     String

  contact Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     ContactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model InvitationCategory {
  id                    String   @id @default(cuid())
  organisationId        String
  eventId               String
  name                  String
  slug                  String
  matchmakingEligible   Boolean  @default(true)
  meetingPrivileges     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitations  Invitation[]
  attendees    Attendee[]

  @@unique([eventId, slug])
  @@index([organisationId])
}

model Invitation {
  id             String           @id @default(cuid())
  organisationId String
  eventId        String
  contactId      String
  categoryId     String?
  status         InvitationStatus @default(DRAFT)
  tokenHash      String           @unique
  sentAt         DateTime?
  openedAt       DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation  Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact       Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  category      InvitationCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  activities    InvitationActivity[]
  registrations RegistrationResponse[]
  attendees     Attendee[]
  emailMessages EmailMessage[]

  @@index([organisationId, eventId])
  @@index([eventId, status])
  @@index([contactId])
}

model InvitationActivity {
  id             String                  @id @default(cuid())
  organisationId String
  eventId        String
  invitationId   String
  type           InvitationActivityType
  payload        Json?
  createdAt      DateTime                @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation   Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([organisationId])
}

model RegistrationForm {
  id             String  @id @default(cuid())
  organisationId String
  eventId        String
  name           String  @default("Default")
  isDefault      Boolean @default(true)

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields       RegistrationField[]

  @@unique([eventId])
  @@index([organisationId, eventId])
}

model RegistrationField {
  id             String  @id @default(cuid())
  organisationId String
  eventId        String
  formId         String
  key            String
  label          String
  type           String
  required       Boolean @default(false)
  options        Json?
  sortOrder      Int     @default(0)

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  form         RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@index([formId])
}

model RegistrationResponse {
  id             String             @id @default(cuid())
  organisationId String
  eventId        String
  invitationId   String?
  contactId      String?
  userId         String?
  status         RegistrationStatus @default(INCOMPLETE)
  data           Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation   Invitation?  @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  attendees    Attendee[]

  @@index([organisationId, eventId])
  @@index([invitationId])
}

model Attendee {
  id               String         @id @default(cuid())
  organisationId   String
  eventId          String
  userId           String?
  contactId        String?
  invitationId     String?
  registrationId   String?
  categoryId       String?
  qrTokenHash      String         @unique
  attendanceTokenEnc String?
  status           AttendeeStatus @default(REGISTERED)
  firstName        String
  lastName         String
  email            String
  phone            String?
  company          String?
  jobTitle         String?
  country          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact      Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invitation   Invitation?           @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  registration RegistrationResponse? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  category     InvitationCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  profile      AttendeeProfile?
  privacy      AttendeePrivacy?
  checkIns     CheckIn[]
  badges       Badge[]
  badgeCredentials BadgeCredential[]
  badgeAccessScans BadgeAccessScan[]
  sessionRegs  SessionRegistration[]
  matchProfile MatchmakingProfile?
  matchScoresA MatchScore[]          @relation("MatchSubject")
  matchScoresB MatchScore[]          @relation("MatchCandidate")
  meetingReqsFrom MeetingRequest[]   @relation("MeetingRequester")
  meetingReqsTo   MeetingRequest[]   @relation("MeetingTarget")
  meetingParts MeetingParticipant[]
  pollResponses EventPollResponse[]
  mapLocation  AttendeeMapLocation?
  mapAnalyticsEvents MapAnalyticsEvent[]

  @@unique([eventId, email])
  @@index([organisationId, eventId])
  @@index([userId])
}

model AttendeeProfile {
  id             String  @id @default(cuid())
  organisationId String
  eventId        String
  attendeeId     String  @unique
  about          String?
  lookingFor     String?
  offering       String?
  interests      Json?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
}

model AttendeePrivacy {
  id                    String  @id @default(cuid())
  organisationId        String
  eventId               String
  attendeeId            String  @unique
  profileVisible        Boolean @default(true)
  matchmakingEnabled    Boolean @default(false)
  matchmakingPaused     Boolean @default(false)
  showEmail             Boolean @default(false)
  showPhone             Boolean @default(false)
  aiInsightsOptIn       Boolean @default(false)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
}

model Session {
  id             String        @id @default(cuid())
  organisationId String
  eventId        String
  title          String
  description    String?
  startsAt       DateTime?
  endsAt         DateTime?
  location       String?
  capacity       Int?
  format         SessionFormat @default(PHYSICAL)

  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations  SessionRegistration[]
  onlineMeetings OnlineMeeting[]
  mapPois        MapPoi[]

  @@index([organisationId, eventId])
}

/// Provider-backed online meeting for an event session (Teams active; Zoom reserved).
model OnlineMeeting {
  id                String                @id @default(cuid())
  organisationId    String
  eventId           String
  sessionId         String
  provider          OnlineMeetingProvider
  providerMeetingId String?
  joinUrl           String?
  metadata          Json?
  createdByUserId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, provider])
  @@index([organisationId, eventId])
}

model SessionRegistration {
  id             String @id @default(cuid())
  organisationId String
  eventId        String
  sessionId      String
  attendeeId     String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, attendeeId])
}

model MatchmakingProfile {
  id             String @id @default(cuid())
  organisationId String
  eventId        String
  attendeeId     String @unique
  questionnaire  Json
  embedding      Json?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
}

model MatchScore {
  id              String @id @default(cuid())
  organisationId  String
  eventId         String
  subjectId       String
  candidateId     String
  score           Float
  reasons         Json?
  aiInsight       String?
  aiRankScore     Float?
  aiRankedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subject      Attendee     @relation("MatchSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  candidate    Attendee     @relation("MatchCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([subjectId, candidateId])
  @@index([organisationId, eventId])
}

model MeetingRequest {
  id                 String               @id @default(cuid())
  organisationId     String
  eventId            String
  requesterId        String
  targetId           String
  status             MeetingRequestStatus @default(PENDING)
  message            String?
  responseTokenHash  String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requester    Attendee     @relation("MeetingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target       Attendee     @relation("MeetingTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([organisationId, eventId])
}

model Meeting {
  id             String        @id @default(cuid())
  organisationId String
  eventId        String
  roomId         String?
  status         MeetingStatus @default(SCHEDULED)
  startsAt       DateTime?
  endsAt         DateTime?
  location       String?

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  room         MeetingRoom?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  calendarEvents CalendarEvent[]

  @@index([organisationId, eventId])
}

model MeetingParticipant {
  id             String @id @default(cuid())
  organisationId String
  eventId        String
  meetingId      String
  attendeeId     String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([meetingId, attendeeId])
}

model MeetingRoom {
  id             String @id @default(cuid())
  organisationId String
  eventId        String
  name           String
  capacity       Int?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meetings     Meeting[]
  mapPois      MapPoi[]

  @@index([organisationId, eventId])
}

model CalendarConnection {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  provider       String
  accessTokenEnc String
  refreshTokenEnc String?
  expiresAt      DateTime?
  scopes         String?

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       CalendarEvent[]

  @@index([userId])
}

/// Organisation-owned HubSpot CRM connection (one per org). Tokens are AES-GCM encrypted.
model HubSpotConnection {
  id                String    @id @default(cuid())
  organisationId    String    @unique
  portalId          String?
  accessTokenEnc    String
  refreshTokenEnc   String
  expiresAt         DateTime?
  scopes            String?
  connectedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("HubSpotConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([connectedByUserId])
}

/// Organisation-owned Salesforce CRM connection (one per org). Tokens are AES-GCM encrypted.
/// instanceUrl is required for API calls (org-specific Salesforce host).
model SalesforceConnection {
  id                String    @id @default(cuid())
  organisationId    String    @unique
  salesforceOrgId   String?
  instanceUrl       String
  accessTokenEnc    String
  refreshTokenEnc   String
  expiresAt         DateTime?
  scopes            String?
  connectedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("SalesforceConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([connectedByUserId])
}

/// Short-lived OAuth CSRF state bound to user + organisation. Single-use.
/// provider is a free-form string (e.g. "hubspot", "salesforce").
model OAuthState {
  id             String    @id @default(cuid())
  nonce          String    @unique
  provider       String
  userId         String
  organisationId String
  /** Optional PKCE verifier (legacy); Salesforce now packs verifier into OAuth state. */
  codeVerifier   String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CalendarEvent {
  id             String  @id @default(cuid())
  organisationId String
  eventId        String
  meetingId      String?
  connectionId   String
  externalId     String?

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meeting      Meeting?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id               String   @id @default(cuid())
  organisationId   String
  eventId          String
  attendeeId       String
  checkedInAt      DateTime @default(now())
  checkedInById    String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  checkedInBy  User?        @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@unique([eventId, attendeeId])
  @@index([organisationId, eventId])
}

/// Desk check-in queues a badge for print; print station marks PRINTED.
/// Invalidate rotates the badge credential and re-queues for a replacement print.
enum BadgeQueueStatus {
  QUEUED
  PRINTED
}

model Badge {
  id               String           @id @default(cuid())
  organisationId   String
  eventId          String
  attendeeId       String
  template         String           @default("zebra_4x3")
  status           BadgeQueueStatus @default(QUEUED)
  /// When the delegate joined the print queue (usually at desk check-in).
  queuedAt         DateTime?
  printedAt        DateTime?
  printedByUserId  String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([eventId, attendeeId])
  @@index([organisationId, eventId, status, queuedAt])
}

/// Printed badge QR credentials — separate from Attendee.qrTokenHash (desk check-in).
/// Reprinting rotates credentials: old hash is REVOKED so shared/lost badges fail at entrance.
enum BadgeCredentialStatus {
  ACTIVE
  REVOKED
}

enum BadgeAccessResult {
  ALLOWED
  DENIED
}

enum BadgeAccessDenyReason {
  REVOKED
  NOT_FOUND
  NOT_CHECKED_IN
}

model BadgeCredential {
  id             String                @id @default(cuid())
  organisationId String
  eventId        String
  attendeeId     String
  /// SHA-256 of the opaque token printed on this badge physical copy.
  tokenHash      String                @unique
  /// Encrypted raw token — only for regenerating this badge's QR.
  tokenEnc       String
  status         BadgeCredentialStatus @default(ACTIVE)
  printNumber    Int
  issuedAt       DateTime              @default(now())
  revokedAt      DateTime?
  revokedReason  String?
  replacedById   String?
  issuedByUserId String?

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee         @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  accessScans  BadgeAccessScan[]

  @@index([organisationId, eventId, attendeeId])
  @@index([eventId, status])
  @@index([attendeeId, status])
}

model BadgeAccessScan {
  id               String                 @id @default(cuid())
  organisationId   String
  eventId          String
  attendeeId       String?
  credentialId     String?
  scannedAt        DateTime               @default(now())
  scannedByUserId  String?
  result           BadgeAccessResult
  denyReason       BadgeAccessDenyReason?
  /// Hash presented at scan (even when revoked/unknown) for audit.
  presentedHash    String?

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee?       @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  credential   BadgeCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([organisationId, eventId, scannedAt])
  @@index([eventId, attendeeId, scannedAt])
}

model EmailTemplate {
  id             String @id @default(cuid())
  organisationId String
  eventId        String?
  key            String
  subject        String
  html           String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaigns    EmailCampaign[]
  messages     EmailMessage[]

  @@unique([organisationId, eventId, key])
}

model EmailCampaign {
  id             String @id @default(cuid())
  organisationId String
  eventId        String
  templateId     String?
  name           String
  scheduledAt    DateTime?

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
