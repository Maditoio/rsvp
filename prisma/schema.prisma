model FileObject {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String?
  kind           FileKind @default(OTHER)
  filename       String
  contentType    String
  url            String?
  sizeBytes      Int?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

enum EventPollStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum EventPollQuestionType {
  SINGLE
  MULTI
  TEXT
}

model EventPoll {
  id              String          @id @default(cuid())
  organisationId  String
  eventId         String
  title           String
  description     String?
  status          EventPollStatus @default(DRAFT)
  publishedAt     DateTime?
  closedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions    EventPollQuestion[]
  responses    EventPollResponse[]

  @@index([organisationId, eventId])
  @@index([eventId, status])
}

model EventPollQuestion {
  id             String                @id @default(cuid())
  organisationId String
  eventId        String
  pollId         String
  label          String
  type           EventPollQuestionType
  required       Boolean               @default(true)
  allowOther     Boolean               @default(false)
  options        Json?
  sortOrder      Int                   @default(0)

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poll         EventPoll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  answers      EventPollAnswer[]

  @@index([pollId, sortOrder])
  @@index([organisationId, eventId])
}

model EventPollResponse {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String
  pollId         String
  attendeeId     String
  userId         String?
  submittedAt    DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  poll         EventPoll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  attendee     Attendee         @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  answers      EventPollAnswer[]

  @@unique([pollId, attendeeId])
  @@index([organisationId, eventId])
  @@index([attendeeId])
}

model EventPollAnswer {
  id                String  @id @default(cuid())
  organisationId    String
  eventId           String
  responseId        String
  questionId        String
  selectedOptionIds Json?
  otherText         String?
  textValue         String?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  response     EventPollResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question     EventPollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([organisationId, eventId])
  @@index([questionId])
}

/// Published venue map for indoor wayfinding (image + POIs + QR checkpoints).
model VenueFloorPlan {
  id             String    @id @default(cuid())
  organisationId String
  eventId        String
  name           String    @default("Main floor")
  floorIndex     Int       @default(0)
  imageUrl       String
  /// { pointA, pointB, realDistance, unit } when calibrated
  calibration    Json?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pois         MapPoi[]
  checkpoints  MapCheckpoint[]
  attendeeLocations AttendeeMapLocation[]
  analyticsEvents MapAnalyticsEvent[]

  @@index([organisationId, eventId])
  @@index([eventId, publishedAt])
}

model MapPoi {
  id             String  @id @default(cuid())
  organisationId String
  eventId        String
  floorPlanId    String
  name           String
  description    String?
  category       String
  /// Normalized 0–1 relative to floor image
  x              Float
  y              Float
  meetingRoomId  String?
  sessionId      String?
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  floorPlan    VenueFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  meetingRoom  MeetingRoom?   @relation(fields: [meetingRoomId], references: [id], onDelete: SetNull)
  session      Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  checkpoints  MapCheckpoint[]
  attendeeLocations AttendeeMapLocation[]
  analyticsEvents MapAnalyticsEvent[]

  @@index([organisationId, eventId])
  @@index([floorPlanId])
  @@index([meetingRoomId])
  @@index([sessionId])
}

/// Venue QR checkpoint — opaque token hashed at rest (not desk/badge QR).
model MapCheckpoint {
  id             String    @id @default(cuid())
  organisationId String
  eventId        String
  floorPlanId    String
  poiId          String?
  label          String
  tokenHash      String    @unique
  /// AES-GCM ciphertext of raw token for reprint / ZIP export only.
  tokenEncrypted String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  disabledAt     DateTime?

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  floorPlan    VenueFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  poi          MapPoi?        @relation(fields: [poiId], references: [id], onDelete: SetNull)
  attendeeLocations AttendeeMapLocation[]
  analyticsEvents MapAnalyticsEvent[]

  @@index([organisationId, eventId])
  @@index([floorPlanId])
}

model AttendeeMapLocation {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String
  attendeeId     String   @unique
  floorPlanId    String
  poiId          String?
  checkpointId   String?
  updatedAt      DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee       @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  floorPlan    VenueFloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  poi          MapPoi?        @relation(fields: [poiId], references: [id], onDelete: SetNull)
  checkpoint   MapCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  @@index([organisationId, eventId])
}

/// Durable attendee map telemetry (search, navigate, presence, QR scans). No raw tokens.
model MapAnalyticsEvent {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String
  attendeeId     String?
  userId         String?
  /// map.search | map.navigate | map.here | checkpoint.scan
  kind           String
  floorPlanId    String?
  poiId          String?
  checkpointId   String?
  /// Sanitized/truncated search query when kind = map.search
  query          String?
  /// Non-secret context (resultCount, floorName, source, …)
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee     Attendee?       @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  floorPlan    VenueFloorPlan? @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
  poi          MapPoi?         @relation(fields: [poiId], references: [id], onDelete: SetNull)
  checkpoint   MapCheckpoint?  @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  @@index([organisationId, eventId, kind, createdAt])
  @@index([poiId])
  @@index([floorPlanId])
  @@index([eventId, createdAt])
}
